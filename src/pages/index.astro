---
import BaseLayout from '../layouts/BaseLayout.astro';
import DiceStage from '../components/DiceStage.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout title="今斤 · Index" iridescence>
  <main class="home">
    <SiteHeader meta="Twenty Faces" />

    <DiceStage />

    <footer class="site-foot">
      <p class="hint mono" data-hint>拖动旋转 · 悬停查看页面 · 点击空白处展开</p>
      <div class="actions">
        <button class="btn btn-primary" type="button" data-roll>随机投掷</button>
      </div>
      <p class="foot-note mono">Randomjin.top</p>
    </footer>
  </main>
</BaseLayout>
