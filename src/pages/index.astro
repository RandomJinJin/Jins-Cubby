---
import BaseLayout from '../layouts/BaseLayout.astro';
import DiceStage from '../components/DiceStage.astro';
---

<BaseLayout title="今斤 · Index">
  <main class="home">
    <header class="site-head">
      <a class="brand" href="https://blog.randomjin.top">
        <img src="/logo.png" alt="" width="26" height="26" />
        <span>今斤</span>
      </a>
      <div class="head-meta">
        <span class="mono">Twenty Faces</span>
        <span class="sep" aria-hidden="true"></span>
        <a class="mono" href="https://github.com/RandomJinJin" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </header>

    <DiceStage />

    <footer class="site-foot">
      <p class="hint mono" data-hint>拖动旋转 · 悬停查看页面 · 点击空白处展开</p>
      <div class="actions">
        <button class="btn btn-primary" type="button" data-roll>随机投掷</button>
      </div>
      <p class="foot-note mono">Randomjin.top</p>
    </footer>
  </main>
</BaseLayout>
