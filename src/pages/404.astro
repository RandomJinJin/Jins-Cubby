---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<BaseLayout title="404 · 今斤" description="页面不存在。" scroll>
  <div class="doc">
    <SiteHeader />

    <main class="doc-main">
      <p class="doc-kicker mono">Not Found</p>
      <h1 class="doc-title">404</h1>

      <div class="doc-prose">
        <p>这一面没有被分配到任何页面。</p>
        <p>
          <a class="doc-link" href="/">回到主站</a>
        </p>
      </div>

      <p class="doc-foot mono">randomjin.top / 404</p>
    </main>
  </div>
</BaseLayout>
