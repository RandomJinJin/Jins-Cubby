---
/**
 * 唱针：圆形转轴壳 + 细直臂 + 梯形唱头 + 针。
 *
 * 与唱片共用 1000×1000 的坐标，转轴圆心 (974,156)、
 * 0° 时针尖落在 (982,482)（= 最外圈年轮 482）。
 * 旋转由页面脚本按年份反解角度后施加。
 */
---

<svg class="tl-tonearm" viewBox="0 0 1000 1000" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="tl-housing" cx="38%" cy="30%" r="72%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="52%" stop-color="#f4f1ea" />
      <stop offset="100%" stop-color="#cfcac0" />
    </radialGradient>
    <linearGradient id="tl-shaft" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#b9b5ac" />
      <stop offset="34%" stop-color="#fefdfb" />
      <stop offset="62%" stop-color="#eae7e1" />
      <stop offset="100%" stop-color="#b3afa6" />
    </linearGradient>
  </defs>

  <g class="tl-arm" data-arm>
    <!-- 转轴外壳 -->
    <circle cx="974" cy="156" r="44" fill="url(#tl-housing)" stroke="#d5d1c9" stroke-width="1.5" />
    <circle cx="974" cy="156" r="30" fill="none" stroke="#c9c4b9" stroke-opacity="0.7" stroke-width="1" />
    <circle cx="974" cy="156" r="13" fill="#efece5" stroke="#bdb8ad" stroke-opacity="0.8" stroke-width="1" />
    <circle cx="974" cy="156" r="5.5" fill="#4a4842" />

    <!-- 直臂 -->
    <line x1="974" y1="156" x2="980" y2="405" stroke="url(#tl-shaft)" stroke-width="9" stroke-linecap="round" />

    <!-- 唱头 -->
    <g transform="rotate(-9 979 431)">
      <path
        d="M963 398 L1000 398 L995 457 Q995 462 990 462 L968 462 Q963 462 963 457 Z"
        fill="#f6f3ec"
        stroke="#cfcabf"
        stroke-width="1.2"
      />
      <path d="M971 405 L992 405 L988 452 L976 452 Z" fill="#ddd8cf" />
    </g>

    <!-- 针尖 -->
    <line x1="980" y1="458" x2="982" y2="480" stroke="#3a3936" stroke-width="2" />
    <circle cx="982" cy="482" r="1.9" fill="#2c2b28" />
  </g>
</svg>
